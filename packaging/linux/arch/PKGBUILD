# Maintainer: Java-Mx <https://github.com/Java-Mx/bitchat-rustpy>
pkgname=bitchat-rustpy
pkgver=0.3.3
pkgrel=1
pkgdesc="Decentralized, encrypted peer-to-peer mesh chat over Bluetooth Low Energy and LAN/Wi-Fi (Rust + Python hybrid)"
arch=('x86_64')
url="https://github.com/Java-Mx/bitchat-rustpy"
license=('MIT')
depends=(
  'bluez'
  'bluez-utils'
  'dbus'
  'gcc-libs'
  'glibc'
  'python>=3.12'
  'python-bleak'
  'python-cryptography'
  'python-dbus-fast'
  'python-textual'
)
makedepends=(
  'cargo'
  'maturin'
  'python-build'
  'python-installer'
  'python-wheel'
  'rust'
)
provides=('bitchat')
conflicts=('bitchat')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo test --workspace --no-default-features
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 packaging/linux/flatpak/io.github.java_mx.bitchat.desktop \
    "${pkgdir}/usr/share/applications/io.github.java_mx.bitchat.desktop"
  install -Dm644 packaging/linux/flatpak/io.github.java_mx.bitchat.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.java_mx.bitchat.metainfo.xml"
  install -Dm644 assets/branding/bitchat_logo.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/io.github.java_mx.bitchat.png"
}
